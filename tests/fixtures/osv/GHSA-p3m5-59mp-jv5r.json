{"id":"GHSA-p3m5-59mp-jv5r","summary":"Next.js: Denial of Service in App Router using Server Actions","details":"## Impact\n\nCrafted requests targeting Next.js applications using App Router with at least one Server Action can lead to excessive CPU usage blocking processing of further requests in the same process.\n\n## Workarounds\n\nNo workaround exists besides upgrading. Applications using Pages Router or not using Server Actions are not vulnerable.","aliases":["CVE-2026-94482"],"modified":"2026-10-22T16:00:09.130954454Z","published":"2026-10-22T15:50:34Z","database_specific":{"cwe_ids":["CWE-770"],"severity":"HIGH","github_reviewed":true,"github_reviewed_at":"2026-10-22T15:50:34Z","nvd_published_at":null},"references":[{"type":"WEB","url":"https://github.com/vercel/next.js/security/advisories/GHSA-p3m5-59mp-jv5r"},{"type":"PACKAGE","url":"https://github.com/vercel/next.js"},{"type":"WEB","url":"https://github.com/vercel/next.js/releases/tag/v15.5.28"},{"type":"WEB","url":"https://github.com/vercel/next.js/releases/tag/v16.4.1"}],"affected":[{"package":{"name":"next","ecosystem":"npm","purl":"pkg:npm/next"},"ranges":[{"type":"SEMVER","events":[{"introduced":"13.0.0"},{"fixed":"15.5.28"}]}],"database_specific":{"last_known_affected_version_range":"\u003c= 15.5.27","source":"https://github.com/github/advisory-database/blob/main/advisories/github-reviewed/2026/10/GHSA-p3m5-59mp-jv5r/GHSA-p3m5-59mp-jv5r.json"}},{"package":{"name":"next","ecosystem":"npm","purl":"pkg:npm/next"},"ranges":[{"type":"SEMVER","events":[{"introduced":"16.0.0"},{"fixed":"16.4.1"}]}],"database_specific":{"last_known_affected_version_range":"\u003c= 16.4.0","source":"https://github.com/github/advisory-database/blob/main/advisories/github-reviewed/2026/10/GHSA-p3m5-59mp-jv5r/GHSA-p3m5-59mp-jv5r.json"}}],"schema_version":"1.9.0","severity":[{"type":"CVSS_V4","score":"CVSS:4.0/AV:N/AC:L/AT:P/PR:N/UI:N/VC:N/VI:N/VA:H/SC:N/SI:N/SA:N"}]}