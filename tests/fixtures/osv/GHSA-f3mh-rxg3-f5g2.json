{"id":"GHSA-f3mh-rxg3-f5g2","summary":"Next.js: HttpOnly cookie exposure through internal response header on Next.js Edge runtime routes","details":"Next.js applications that set cookies through `NextResponse` on Edge runtime routes — App Router route handlers and Pages Router Edge API routes — send an internal `x-middleware-set-cookie` header in the public response, duplicating the cookie value and its attributes. This makes HttpOnly cookies, such as session tokens, readable by JavaScript running on the same origin when an application sets a sensitive cookie on an affected response.","aliases":["CVE-2026-119346"],"modified":"2026-11-19T22:45:06.180078081Z","published":"2026-11-19T22:23:21Z","database_specific":{"github_reviewed":true,"github_reviewed_at":"2026-11-19T22:23:21Z","nvd_published_at":"2026-11-16T19:17:26Z","cwe_ids":["CWE-200","CWE-201"],"severity":"MODERATE"},"references":[{"type":"WEB","url":"https://github.com/vercel/next.js/security/advisories/GHSA-f3mh-rxg3-f5g2"},{"type":"ADVISORY","url":"https://nvd.nist.gov/vuln/detail/CVE-2026-119346"},{"type":"WEB","url":"https://github.com/vercel/next.js/commit/809be725f033ec7aa4c658ba2b7a084cb039d1f2"},{"type":"WEB","url":"https://github.com/vercel/next.js/commit/9fc04bd869ded4900bed7d069832aa2c5f56fa29"},{"type":"PACKAGE","url":"https://github.com/vercel/next.js"},{"type":"WEB","url":"https://github.com/vercel/next.js/releases/tag/v15.5.29"},{"type":"WEB","url":"https://github.com/vercel/next.js/releases/tag/v16.4.5"},{"type":"WEB","url":"https://nextjs.org/blog/november-2026-security-release"}],"affected":[{"package":{"name":"next","ecosystem":"npm","purl":"pkg:npm/next"},"ranges":[{"type":"SEMVER","events":[{"introduced":"15.0.0"},{"fixed":"15.5.29"}]}],"database_specific":{"last_known_affected_version_range":"\u003c= 15.5.28","source":"https://github.com/github/advisory-database/blob/main/advisories/github-reviewed/2026/11/GHSA-f3mh-rxg3-f5g2/GHSA-f3mh-rxg3-f5g2.json"}},{"package":{"name":"next","ecosystem":"npm","purl":"pkg:npm/next"},"ranges":[{"type":"SEMVER","events":[{"introduced":"16.0.0"},{"fixed":"16.4.5"}]}],"database_specific":{"last_known_affected_version_range":"\u003c= 16.4.4","source":"https://github.com/github/advisory-database/blob/main/advisories/github-reviewed/2026/11/GHSA-f3mh-rxg3-f5g2/GHSA-f3mh-rxg3-f5g2.json"}}],"schema_version":"1.9.2","severity":[{"type":"CVSS_V4","score":"CVSS:4.0/AV:N/AC:H/AT:N/PR:N/UI:P/VC:H/VI:N/VA:N/SC:N/SI:N/SA:N"}]}