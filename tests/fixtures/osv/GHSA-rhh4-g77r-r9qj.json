{"id":"GHSA-rhh4-g77r-r9qj","summary":"Next.js: Cross-user cache disclosure and poisoning in Next.js use cache with binary arguments","details":"Next.js App Router applications that pass binary arguments (such as Uint8Array or Blob values) to functions using the `use cache` directive can produce identical cache keys for distinct arguments, allowing cached results to be shared across users — cross-user disclosure of cached data or cache poisoning. This affects applications using `use cache` with binary arguments.","aliases":["CVE-2026-119349"],"modified":"2026-11-19T22:45:06.179610242Z","published":"2026-11-19T22:20:11Z","database_specific":{"cwe_ids":["CWE-694"],"severity":"MODERATE","github_reviewed":true,"github_reviewed_at":"2026-11-19T22:20:11Z","nvd_published_at":"2026-11-16T19:17:27Z"},"references":[{"type":"WEB","url":"https://github.com/vercel/next.js/security/advisories/GHSA-rhh4-g77r-r9qj"},{"type":"ADVISORY","url":"https://nvd.nist.gov/vuln/detail/CVE-2026-119349"},{"type":"WEB","url":"https://github.com/vercel/next.js/commit/6596840a0fa3c2633735b05e41ca3d9ab01ece41"},{"type":"PACKAGE","url":"https://github.com/vercel/next.js"},{"type":"WEB","url":"https://github.com/vercel/next.js/releases/tag/v16.4.5"},{"type":"WEB","url":"https://nextjs.org/blog/november-2026-security-release"}],"affected":[{"package":{"name":"next","ecosystem":"npm","purl":"pkg:npm/next"},"ranges":[{"type":"SEMVER","events":[{"introduced":"16.0.0"},{"fixed":"16.4.5"}]}],"database_specific":{"last_known_affected_version_range":"\u003c= 16.4.4","source":"https://github.com/github/advisory-database/blob/main/advisories/github-reviewed/2026/11/GHSA-rhh4-g77r-r9qj/GHSA-rhh4-g77r-r9qj.json"}}],"schema_version":"1.9.2","severity":[{"type":"CVSS_V4","score":"CVSS:4.0/AV:N/AC:L/AT:P/PR:N/UI:N/VC:L/VI:L/VA:N/SC:N/SI:N/SA:N"}]}