{"id":"GHSA-pc58-hwjq-p385","summary":"Next.js: Cross-client response injection and disclosure in self-hosted Next.js applications forwarding fetched responses","details":"Self-hosted Next.js applications (App Router route handlers and the fetch cache) that return a fetched upstream response unchanged can emit a response whose declared framing does not match the body actually sent. When such an application sits behind an HTTP/1.1 reverse proxy that permits pipelined response queueing, a crafted upstream response can desynchronize responses between clients, enabling response injection and disclosure of other clients' responses.","aliases":["CVE-2026-119348"],"modified":"2026-11-19T22:45:06.189800429Z","published":"2026-11-19T22:20:34Z","database_specific":{"nvd_published_at":"2026-11-16T19:17:26Z","cwe_ids":["CWE-444"],"severity":"MODERATE","github_reviewed":true,"github_reviewed_at":"2026-11-19T22:20:34Z"},"references":[{"type":"WEB","url":"https://github.com/vercel/next.js/security/advisories/GHSA-pc58-hwjq-p385"},{"type":"ADVISORY","url":"https://nvd.nist.gov/vuln/detail/CVE-2026-119348"},{"type":"WEB","url":"https://github.com/vercel/next.js/commit/2842833be3a5a1e5fef0c5fb8c96df74742eef2a"},{"type":"WEB","url":"https://github.com/vercel/next.js/commit/848ec29a3fbe68c02edb022efe19b04356997c32"},{"type":"PACKAGE","url":"https://github.com/vercel/next.js"},{"type":"WEB","url":"https://github.com/vercel/next.js/releases/tag/v15.5.29"},{"type":"WEB","url":"https://github.com/vercel/next.js/releases/tag/v16.4.5"},{"type":"WEB","url":"https://nextjs.org/blog/november-2026-security-release"}],"affected":[{"package":{"name":"next","ecosystem":"npm","purl":"pkg:npm/next"},"ranges":[{"type":"SEMVER","events":[{"introduced":"16.0.0"},{"fixed":"16.4.5"}]}],"database_specific":{"source":"https://github.com/github/advisory-database/blob/main/advisories/github-reviewed/2026/11/GHSA-pc58-hwjq-p385/GHSA-pc58-hwjq-p385.json","last_known_affected_version_range":"\u003c= 16.4.4"}},{"package":{"name":"next","ecosystem":"npm","purl":"pkg:npm/next"},"ranges":[{"type":"SEMVER","events":[{"introduced":"0"},{"fixed":"15.5.29"}]}],"database_specific":{"source":"https://github.com/github/advisory-database/blob/main/advisories/github-reviewed/2026/11/GHSA-pc58-hwjq-p385/GHSA-pc58-hwjq-p385.json","last_known_affected_version_range":"\u003c= 15.5.28"}}],"schema_version":"1.9.2","severity":[{"type":"CVSS_V4","score":"CVSS:4.0/AV:N/AC:H/AT:P/PR:N/UI:N/VC:L/VI:L/VA:N/SC:N/SI:N/SA:N"}]}