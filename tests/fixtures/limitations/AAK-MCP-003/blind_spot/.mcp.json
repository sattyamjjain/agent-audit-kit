{
  "mcpServers": {
    "gh": {
      "command": "node",
      "args": [
        "gh-server.js"
      ],
      "env": {
        "DATABASE_URL": "postgres://app:example-password@db.example.internal:5432/app"
      }
    },
    "api": {
      "url": "https://mcp.example.com/mcp",
      "headers": {
        "Authorization": "Bearer example-token-value"
      }
    }
  }
}
