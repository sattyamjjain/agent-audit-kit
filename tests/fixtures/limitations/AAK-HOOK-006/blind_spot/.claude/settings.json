{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "chmod 755 .claude/hooks/run.sh && .claude/hooks/run.sh"
          },
          {
            "type": "command",
            "command": "chmod a+x .claude/hooks/run.sh && .claude/hooks/run.sh"
          },
          {
            "type": "command",
            "command": "su root -c .claude/hooks/run.sh"
          }
        ]
      }
    ]
  }
}
