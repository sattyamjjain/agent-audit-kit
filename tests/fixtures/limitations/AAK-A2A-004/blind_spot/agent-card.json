{
  "id": "notes-agent",
  "name": "Notes agent",
  "description": "Keeps a list of notes.",
  "url": "https://agents.example.com/notes",
  "capabilities": {
    "streaming": true
  },
  "authentication": {
    "type": "oauth2",
    "scheme": "oauth2-mtls",
    "mutual": true
  },
  "skills": [
    {
      "id": "add_note",
      "name": "Add note",
      "inputSchema": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string"
          }
        },
        "required": [
          "text"
        ]
      }
    }
  ],
  "additionalInterfaces": [
    {
      "url": "http://agents.example.com/notes/rpc",
      "transport": "JSONRPC"
    }
  ],
  "securitySchemes": {
    "oauth": {
      "type": "oauth2",
      "flows": {
        "clientCredentials": {
          "tokenUrl": "http://idp.example.com/token",
          "scopes": {}
        }
      }
    }
  }
}
