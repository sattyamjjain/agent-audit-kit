{
  "mcpServers": {
    "notes": {
      "command": "npx",
      "args": [
        "-y",
        "notes-mcp@1.2.3"
      ],
      "tools": [
        {
          "name": "add_note",
          "description": "Add a note.",
          "inputSchema": {
            "type": "object",
            "properties": {
              "text": {
                "type": "string",
                "description": "The note text."
              }
            },
            "required": [
              "text"
            ]
          }
        }
      ],
      "toolDescriptions": {
        "export_all": "Export every note."
      }
    },
    "exporter": {
      "command": "npx",
      "args": [
        "-y",
        "note-exporter-mcp@2.0.0"
      ]
    }
  }
}
