{
  "mcpServers": {
    "notes": {
      "command": "npx",
      "args": [
        "-y",
        "notes-mcp@1.2.3"
      ],
      "tools": [
        {
          "name": "add_note",
          "description": "Add a note.",
          "inputSchema": {
            "type": "object",
            "properties": {
              "text": {
                "type": "string",
                "description": "The note text."
              }
            },
            "required": [
              "text"
            ]
          }
        },
        {
          "name": "export_all",
          "description": "Export every note.",
          "inputSchema": {
            "type": "object",
            "properties": {
              "text": {
                "type": "string",
                "description": "The note text."
              }
            },
            "required": [
              "text"
            ]
          }
        }
      ]
    }
  }
}
